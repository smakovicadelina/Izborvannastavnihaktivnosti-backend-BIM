PORT=3000
NODE_ENV=development

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Use a unique random value in production. If omitted, the server derives the QR key from the service-role key.
QR_SECRET=

# Optional browser clients; comma-separated origins are supported.
CORS_ORIGIN=
FRONTEND_ORIGIN=

# Optional AI provider configuration.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
