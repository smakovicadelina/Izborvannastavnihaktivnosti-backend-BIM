# Kopirati u .env i popuniti. Fajl .env se NIKADA ne commit-uje (nalazi se u .gitignore).

PORT=3000
NODE_ENV=development

# Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Javni (publishable / anon) kljuc - koristi se za registraciju, prijavu i proveru tokena.
SUPABASE_ANON_KEY=your-supabase-anon-key
# TAJNI (secret / service_role) kljuc - samo na serveru, nikada u mobilnoj aplikaciji.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Tajna za potpisivanje QR kodova za prisustvo. Ako je prazna, izvodi se iz service-role kljuca.
QR_SECRET=

# Dodatni dozvoljeni web domeni (CORS), odvojeni zarezom. Mobilna aplikacija ne podleze CORS-u.
CORS_ORIGIN=
FRONTEND_ORIGIN=

# Opciono: AI preporuke preko Claude-a. Bez kljuca se koristi lokalni algoritam.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
